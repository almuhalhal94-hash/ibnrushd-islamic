rules_version = '2';
// مكتب المعلم الأول: القراءة والكتابة لحسابات Google المعتمدة فقط.
// لإضافة حساب: أضف إيميله في القائمة وانشر القواعد من Firebase Console ← Firestore ← Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['technoislamic7@gmail.com'];
    }
    match /{col}/{id} {
      allow read, write: if allowed()
        && col in ['minutes', 'visits', 'plan', 'reports', 'exams'];
    }
    // «اليوم المفتوح»: تقرير كل طالب مشفّر برقمه الشخصي واسمه مشتق منه،
    // فأي زائر يقرأ مستندًا واحدًا بالاسم فقط، ولا أحد يقدر يعرض القائمة أو يكتب إلا الحساب المعتمد.
    match /yawm/{id} {
      allow get: if true;
      allow list, write: if allowed();
    }
  }
}
